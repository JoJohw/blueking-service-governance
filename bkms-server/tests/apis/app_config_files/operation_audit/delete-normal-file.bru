meta {
  name: delete-normal-file
  type: http
  seq: 3
}

delete {
  url: {{serviceURL}}/apps/{{appCfgAuditAppID}}/app-config-files/{{appCfgAuditNormalFileID}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should delete normal app config file", () => {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
