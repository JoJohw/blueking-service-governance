meta {
  name: set-base-content
  type: http
  seq: 5
}

put {
  url: {{serviceURL}}/apps/{{appCfgAuditAppID}}/app-config-files/{{appCfgAuditBaseFileID}}/content
  body: json
  auth: inherit
}

body:json {
  {
    "content": "foo: base",
    "versionDescription": "更新基础文件内容"
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should update base content", () => {
    expect(res.body.compiledContent).to.equal("foo: base");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
