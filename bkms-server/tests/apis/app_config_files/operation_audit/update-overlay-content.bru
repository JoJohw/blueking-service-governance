meta {
  name: update-overlay-content
  type: http
  seq: 7
}

put {
  url: {{serviceURL}}/apps/{{appCfgAuditAppID}}/app-config-files/{{appCfgAuditOverlayFileID}}/overlay-content
  body: json
  auth: inherit
}

body:json {
  {
    "overlayContent": "foo: overlay",
    "versionDescription": "更新覆盖层内容"
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should update overlay content", () => {
    expect(res.body.compiledContent.trim()).to.equal("foo: overlay");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
