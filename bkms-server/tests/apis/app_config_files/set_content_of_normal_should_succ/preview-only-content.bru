meta {
  name: preview-only-content
  type: http
  seq: 3
}

put {
  url: {{serviceURL}}/apps/{{valuesNormalHelmAppID}}/app-config-files/{{currentVFileID}}/content
  body: json
  auth: inherit
}

body:json {
  {
    "content": "foo: preview-only",
    "previewOnly": true,
    "versionDescription": "预览更新"
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should preview content without persisting", () => {
    expect(res.body.compiledContent).to.equal("foo: preview-only");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
