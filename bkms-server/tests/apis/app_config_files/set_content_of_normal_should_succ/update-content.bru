meta {
  name: update-content
  type: http
  seq: 2
}

put {
  url: {{serviceURL}}/apps/{{valuesNormalHelmAppID}}/app-config-files/{{currentVFileID}}/content
  body: json
  auth: inherit
}

body:json {
  {
    "content": "foo: bar",
    "versionDescription": "更新内容"
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return the right type and name", () => {
    expect(res.body.compiledContent).to.equal('foo: bar');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
