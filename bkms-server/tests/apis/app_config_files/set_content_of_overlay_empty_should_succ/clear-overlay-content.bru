meta {
  name: clear-overlay-content
  type: http
  seq: 5
}

put {
  url: {{serviceURL}}/apps/{{valuesOverlayHelmAppID}}/app-config-files/{{currentVFileID}}/overlay-content
  body: json
  auth: inherit
}

body:json {
  {
    "overlayContent": "",
    "versionDescription": "清空 overlay 内容"
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should persist empty overlay and compile back to base content", () => {
    expect(res.body.compiledContent).to.equal('base: value');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
