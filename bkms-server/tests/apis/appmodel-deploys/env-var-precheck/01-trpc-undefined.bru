meta {
  name: 01-trpc-undefined
  type: http
  seq: 1
}

get {
  url: {{serviceURL}}/apps/{{envVarPrecheckTrpcAppID}}/envs/{{envVarPrecheckEnvName}}/trpc-deploys/env-var-precheck
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return the exact tRPC undefined variable response", () => {
    expect(res.body).to.deep.equal({
      undefinedVars: [{
        key: bru.getVar("envVarPrecheckTrpcUndefinedKey"),
        sources: [{type: "appConfigFile", name: "default"}]
      }]
    });
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
