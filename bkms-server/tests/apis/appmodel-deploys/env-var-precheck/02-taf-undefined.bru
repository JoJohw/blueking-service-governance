meta {
  name: 02-taf-undefined
  type: http
  seq: 2
}

get {
  url: {{serviceURL}}/apps/{{envVarPrecheckTafAppID}}/envs/{{envVarPrecheckEnvName}}/taf-deploys/env-var-precheck
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return the exact TAF undefined variable response", () => {
    expect(res.body).to.deep.equal({
      undefinedVars: [{
        key: bru.getVar("envVarPrecheckTafUndefinedKey"),
        sources: [{type: "appConfigFile", name: "default"}]
      }]
    });
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
