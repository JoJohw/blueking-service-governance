meta {
  name: 03-defined-empty-passes
  type: http
  seq: 3
}

get {
  url: {{serviceURL}}/apps/{{envVarPrecheckDefinedAppID}}/envs/{{envVarPrecheckEnvName}}/trpc-deploys/env-var-precheck
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should treat an empty defined value as present", () => {
    expect(res.body).to.deep.equal({undefinedVars: []});
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
