meta {
  name: 02-list-trpc-wrong-app-type
  type: http
  seq: 3
}

get {
  url: {{serviceURL}}/apps/{{appmodelDeployFailHelmAppID}}/envs/{{appmodelDeployFailEnvName}}/trpc-deploys?page=1&pageSize=10
  body: none
  auth: inherit
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject helm app on trpc-deploys list", () => {
    expect(res.body.error).to.be.an("object");
    // validateAppModelDeployAppEnv -> "not appmodel app" with INVALID_REQUEST.
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
    expect(res.body.error.message).to.contain("not appmodel app");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
  });
}

settings {
  encodeUrl: true
  timeout: 5000
}
