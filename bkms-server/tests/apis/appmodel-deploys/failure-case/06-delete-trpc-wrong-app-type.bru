meta {
  name: 06-delete-trpc-wrong-app-type
  type: http
  seq: 8
}

delete {
  url: {{serviceURL}}/apps/{{appmodelDeployFailHelmAppID}}/envs/{{appmodelDeployFailEnvName}}/trpc-deploys
  body: none
  auth: inherit
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject helm app on trpc-deploys delete", () => {
    expect(res.body.error).to.be.an("object");
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
    expect(res.body.error.message).to.contain("not appmodel app");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
  });
}

settings {
  encodeUrl: true
  timeout: 5000
}
