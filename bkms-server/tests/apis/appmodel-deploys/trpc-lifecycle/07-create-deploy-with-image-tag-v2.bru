meta {
  name: 07-create-deploy-with-image-tag-v2
  type: http
  seq: 7
}

post {
  url: {{serviceURL}}/apps/{{trpcLifecycleAppID}}/envs/{{trpcLifecycleEnvName}}/trpc-deploys
  body: json
  auth: inherit
}

body:json {
  {
    "imageTag": "{{trpcLifecycleImageTag2}}",
    "replicas": 2
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  if (res.status !== 200) {
    return;
  }

  // Wait for the v2 record to appear (different id than v1) and reach a
  // terminal state. excludeID guards against accidentally matching v1.
  const appmodel = require("./helpers/appmodel");

  const record = await appmodel.waitForAppModelDeployTerminal({
    kind: "trpc",
    appID: bru.getVar("trpcLifecycleAppID"),
    envName: bru.getVar("trpcLifecycleEnvName"),
    expectedStatus: "deployed",
    imageTag: bru.getVar("trpcLifecycleImageTag2"),
    excludeID: bru.getVar("trpcLifecycleFirstDeployID")
  });
  bru.setVar("trpcLifecycleSecondDeployID", record.id);
  bru.setVar("trpcLifecycleSecondDeployStatus", record.status);
  bru.setVar("trpcLifecycleSecondDeployReplicas", record.replicas);
}

tests {
  test("should create the v2 trpc-deploy distinct from v1 and converge to deployed", () => {
    expect(res.body).to.deep.equal({});
    const v1 = bru.getVar("trpcLifecycleFirstDeployID");
    const v2 = bru.getVar("trpcLifecycleSecondDeployID");
    expect(v2).to.be.a("string").and.not.empty;
    expect(v2).to.not.equal(v1);
    expect(bru.getVar("trpcLifecycleSecondDeployStatus")).to.equal("deployed");
    expect(parseInt(bru.getVar("trpcLifecycleSecondDeployReplicas"), 10)).to.equal(2);
  });
}

settings {
  encodeUrl: true
  timeout: 70000
}
