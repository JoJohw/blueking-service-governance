meta {
  name: env-get-effective-after-del
  type: http
  seq: 8
}

get {
  url: {{serviceURL}}/apps/{{annotationsAppID}}/envs/test/app-spec/annotations/effective
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should fall back to default annotations after env override deleted", () => {
    expect(res.body.data.annotations.version).to.equal("v1");
    expect(res.body.data.annotations.region).to.equal(undefined);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
