meta {
  name: env-update-full
  type: http
  seq: 5
}

put {
  url: {{serviceURL}}/apps/{{annotationsAppID}}/envs/test/app-spec/annotations
  body: json
  auth: inherit
}

body:json {
  {
    "annotations": {
      "version": "v2",
      "region": "sh"
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

settings {
  encodeUrl: true
  timeout: 0
}
