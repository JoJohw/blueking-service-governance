meta {
  name: update-default-should-fail-when-key-invalid
  type: http
  seq: 2
}

put {
  url: {{serviceURL}}/apps/{{annotationsAppID}}/app-spec/default-annotations
  body: json
  auth: inherit
}

body:json {
  {
    "annotations": {
      "invalid key!": "value"
    }
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject invalid annotation key", () => {
    expect(res.body.error.message).to.contains("is invalid");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
