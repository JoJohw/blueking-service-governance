meta {
  name: update-default-should-fail-when-key-reserved
  type: http
  seq: 9
}

put {
  url: {{serviceURL}}/apps/{{annotationsAppID}}/app-spec/default-annotations
  body: json
  auth: inherit
}

body:json {
  {
    "annotations": {
      "controller.kubernetes.io/pod-deletion-cost": "100"
    }
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject system-reserved annotation key", () => {
    expect(res.body.error.message).to.contains("reserved by the system");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
