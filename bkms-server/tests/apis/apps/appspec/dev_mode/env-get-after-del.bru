meta {
  name: env-get-after-del
  type: http
  seq: 7
}

get {
  url: {{serviceURL}}/apps/{{devModeAppID}}/envs/test/app-spec/dev-mode
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
  res.body: isJson
}

tests {
  test("should return not found after deleting env dev mode override", () => {
    expect(res.body.error.message).to.contains("env dev mode not found");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
