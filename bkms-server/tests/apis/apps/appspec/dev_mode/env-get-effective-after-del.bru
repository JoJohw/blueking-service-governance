meta {
  name: env-get-effective-after-del
  type: http
  seq: 8
}

get {
  url: {{serviceURL}}/apps/{{devModeAppID}}/envs/test/app-spec/dev-mode/effective
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return null after deleting env dev mode override", () => {
    expect(res.body.data).to.equal(null);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
