meta {
  name: env-update-full
  type: http
  seq: 3
}

put {
  url: {{serviceURL}}/apps/{{devModeAppID}}/envs/test/app-spec/dev-mode
  body: json
  auth: inherit
}

body:json {
  {
    "appSpecDevMode": {
      "enabled": true
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

settings {
  encodeUrl: true
  timeout: 0
}
