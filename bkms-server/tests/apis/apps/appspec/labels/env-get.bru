meta {
  name: env-get
  type: http
  seq: 6
}

get {
  url: {{serviceURL}}/apps/{{labelsAppID}}/envs/test/app-spec/labels
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return the raw env override labels", () => {
    expect(res.body.data.labels.version).to.equal("v2");
    expect(res.body.data.labels.region).to.equal("sh");
    expect(res.body.data.labels.team).to.equal(undefined);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
