meta {
  name: env-set-partial
  type: http
  seq: 9
}

put {
  url: {{serviceURL}}/apps/{{lifecycleAppID}}/envs/{{testEnv}}/app-spec/lifecycle
  body: json
  auth: inherit
}

body:json {
  {
    "appSpecLifecycle": {
      "preStop": {
        "type": "EXEC",
        "exec": {
          "sleepSeconds": 3
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

settings {
  encodeUrl: true
  timeout: 0
}
