meta {
  name: get-overview-should-empty
  type: http
  seq: 2
}

get {
  url: {{serviceURL}}/apps/{{lifecycleAppID}}/app-spec/overview
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data.configuredEnvs: isEmpty
}

settings {
  encodeUrl: true
  timeout: 0
}
