meta {
  name: set-default-http
  type: http
  seq: 5
}

put {
  url: {{serviceURL}}/apps/{{lifecycleAppID}}/app-spec/default-lifecycle
  body: json
  auth: inherit
}

body:json {
  {
    "appSpecLifecycle": {
      "postStart": {
        "type": "HTTP",
        "http": {
          "url": "http://localhost:8080/start",
          "headers": {
            "X-Custom": "value"
          }
        }
      },
      "preStop": {
        "type": "HTTP",
        "http": {
          "url": "http://localhost:8080/stop"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

settings {
  encodeUrl: true
  timeout: 0
}
