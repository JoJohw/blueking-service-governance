meta {
  name: env-get-after-del-all-by-type
  type: http
  seq: 20
}

get {
  url: {{serviceURL}}/apps/{{probeAppID}}/envs/{{testEnv}}/app-spec/probe
  auth: inherit
}

assert {
  res.status: eq 404
  res.body: isJson
}

tests {
  test("should return not found after all probes deleted by type", () => {
    expect(res.body.error.message).to.contains("probe not found");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
