meta {
  name: env-set
  type: http
  seq: 6
}

put {
  url: {{serviceURL}}/apps/{{probeAppID}}/envs/{{testEnv}}/app-spec/probe
  body: json
  auth: inherit
}

body:json {
  {
    "appSpecProbe": {
      "liveness": {
        "probeHandler": {
          "type": "HTTP",
          "url": "http://localhost/env-health",
          "port": 8080
        },
        "periodSeconds": 15
      }
    }
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
