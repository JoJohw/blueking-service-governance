meta {
  name: check-partial-result
  type: http
  seq: 7
}

get {
  url: {{serviceURL}}/apps/{{resourcesAppID}}/envs/test/app-spec/resources/effective
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return the merged values", () => {
    expect(res.body.data.replicas).to.equal(2);
    expect(res.body.data.cpuRequests).to.equal("3");
    expect(res.body.data.cpuLimits).to.equal("3");
    expect(res.body.data.memoryRequests).to.equal("256Mi");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
