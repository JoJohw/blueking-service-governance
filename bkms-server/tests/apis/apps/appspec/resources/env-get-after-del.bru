meta {
  name: env-get-after-del
  type: http
  seq: 12
}

get {
  url: {{serviceURL}}/apps/{{resourcesAppID}}/envs/test/app-spec/resources
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
  res.body: isJson
}

tests {
  test("should return not found after deleting env resources override", () => {
    expect(res.body.error.message).to.contains("env resources not found");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
