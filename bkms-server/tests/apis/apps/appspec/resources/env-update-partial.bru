meta {
  name: env-update-partial
  type: http
  seq: 6
}

put {
  url: {{serviceURL}}/apps/{{resourcesAppID}}/envs/test/app-spec/resources
  body: json
  auth: inherit
}

body:json {
  {
    "appSpecResources": {
      "cpuRequests": "3",
      "cpuLimits": "3"
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

settings {
  encodeUrl: true
  timeout: 0
}
