meta {
  name: get-again-default
  type: http
  seq: 4
}

get {
  url: {{serviceURL}}/apps/{{resourcesAppID}}/app-spec/default-resources
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return the updated values", () => {
    expect(res.body.data.replicas).to.equal(2);
    expect(res.body.data.cpuRequests).to.equal("1");
    expect(res.body.data.memoryRequests).to.equal("256Mi");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
