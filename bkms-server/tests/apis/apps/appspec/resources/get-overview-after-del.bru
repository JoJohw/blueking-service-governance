meta {
  name: get-overview-after-del
  type: http
  seq: 15
}

get {
  url: {{serviceURL}}/apps/{{resourcesAppID}}/app-spec/overview
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data.configuredEnvs: isEmpty
}

settings {
  encodeUrl: true
  timeout: 0
}
