meta {
  name: check-partial-result
  type: http
  seq: 6
}

get {
  url: {{serviceURL}}/apps/{{updateStrategyAppID}}/envs/test/app-spec/update-strategy/effective
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return the merged values", () => {
    expect(res.body.data.maxUnavailable).to.equal("33%");
    expect(res.body.data.maxSurge).to.equal("3");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
