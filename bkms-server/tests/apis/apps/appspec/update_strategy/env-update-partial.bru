meta {
  name: env-update-partial
  type: http
  seq: 5
}

put {
  url: {{serviceURL}}/apps/{{updateStrategyAppID}}/envs/test/app-spec/update-strategy
  body: json
  auth: inherit
}

body:json {
  {
    "appSpecUpdateStrategy": {
      "maxUnavailable": "33%"
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

settings {
  encodeUrl: true
  timeout: 0
}
