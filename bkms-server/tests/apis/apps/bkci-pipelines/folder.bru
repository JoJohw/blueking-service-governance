meta {
  name: bkci-pipelines
  seq: 10
}

auth {
  mode: inherit
}

script:pre-request {
  const common = require("./common")

  if (!bru.getVar("testBkciWorkspaceID")) {
    const suffix = bru.getVar("randomSuffix");
    const ws = await common.createWorkspace({id: `bkci-ws-${suffix}`})

    bru.setVar("workspaceID", ws.id);
    bru.setVar("testBkciWorkspaceID", ws.id);
  }

  const workspaceID = bru.getVar("testBkciWorkspaceID");
  bru.setVar("workspaceID", workspaceID);
}
