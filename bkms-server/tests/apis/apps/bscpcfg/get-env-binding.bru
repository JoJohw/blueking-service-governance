meta {
  name: get-env-binding
  type: http
  seq: 4
}

get {
  url: {{serviceURL}}/apps/{{bscpCfgAppID}}/bscpcfg/envs/{{bscpCfgEnvName}}/binding
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data.appID: eq {{bscpCfgAppID}}
  res.body.data.envName: eq {{bscpCfgEnvName}}
  res.body.data.workloadName: isString
}

tests {
  test("should get env binding detail", () => {
    const data = res.body.data;
    expect(data.appID).to.equal(bru.getVar("bscpCfgAppID"));
    expect(data.envName).to.equal(bru.getVar("bscpCfgEnvName"));
    expect(data.workloadName).to.be.a("string");
    expect(data.bscpBizID).to.be.a("string").and.not.empty;
    expect(data.apps).to.be.an("array").and.have.length.greaterThan(0);
    expect(data.defaultFileAppID).to.equal(bru.getVar("bscpCfgDefaultFileAppID"));
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
