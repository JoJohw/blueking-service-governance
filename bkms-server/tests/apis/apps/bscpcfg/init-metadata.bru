meta {
  name: init-metadata
  type: http
  seq: 1
}

post {
  url: {{serviceURL}}/apps/{{bscpCfgAppID}}/bscpcfg/metadata
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data.appID: eq {{bscpCfgAppID}}
  res.body.data.bscpBizID: isString
  res.body.data.feedAddr: isString
  res.body.data.token: isString
}

tests {
  test("should init bscpcfg metadata with required fields", () => {
    const data = res.body.data;
    expect(data.appID).to.equal(bru.getVar("bscpCfgAppID"));
    expect(data.bscpBizID).to.be.a("string").and.not.empty;
    expect(data.feedAddr).to.be.a("string").and.not.empty;
    expect(data.token).to.be.a("string").and.not.empty;
    expect(data.credentialName).to.be.a("string").and.not.empty;
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
