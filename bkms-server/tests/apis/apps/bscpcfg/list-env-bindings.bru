meta {
  name: list-env-bindings
  type: http
  seq: 5
}

get {
  url: {{serviceURL}}/apps/{{bscpCfgAppID}}/bscpcfg/envs
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("should list all env bindings for the app", () => {
    const data = res.body.data;
    expect(data).to.be.an("array");
    expect(data.length).to.be.greaterThan(0);

    const binding = data.find(item => item.envName === bru.getVar("bscpCfgEnvName"));
    expect(binding).to.not.be.undefined;
    expect(binding.appID).to.equal(bru.getVar("bscpCfgAppID"));
    expect(binding.workloadName).to.be.a("string");
    expect(binding.defaultFileAppID).to.equal(bru.getVar("bscpCfgDefaultFileAppID"));
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
