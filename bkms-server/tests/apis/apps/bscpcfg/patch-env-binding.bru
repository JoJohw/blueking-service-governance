meta {
  name: patch-env-binding
  type: http
  seq: 6
}

patch {
  url: {{serviceURL}}/apps/{{bscpCfgAppID}}/bscpcfg/envs/{{bscpCfgEnvName}}/binding
  body: json
  auth: inherit
}

body:json {
  {
    "apps": [
      {"id": "{{bscpCfgDefaultFileAppID}}", "name": "{{bscpCfgDefaultFileAppName}}"}
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("should update env binding services list", () => {
    expect(res.status).to.equal(200);
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
