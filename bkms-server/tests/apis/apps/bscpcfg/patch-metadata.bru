meta {
  name: patch-metadata
  type: http
  seq: 2
}

patch {
  url: {{serviceURL}}/apps/{{bscpCfgAppID}}/bscpcfg/metadata
  body: json
  auth: inherit
}

body:json {
  {
    "mountPath": "/data/bscp",
    "workloadName": "{{bscpCfgAppName}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.appID: eq {{bscpCfgAppID}}
  res.body.data.mountPath: eq /data/bscp
  res.body.data.workloadName: eq {{bscpCfgAppName}}
}

tests {
  test("should update bscpcfg metadata mountPath and workloadName", () => {
    const data = res.body.data;
    expect(data.appID).to.equal(bru.getVar("bscpCfgAppID"));
    expect(data.mountPath).to.equal("/data/bscp");
    expect(data.workloadName).to.equal(bru.getVar("bscpCfgAppName"));
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
