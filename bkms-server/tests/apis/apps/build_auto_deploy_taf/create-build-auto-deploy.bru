meta {
  name: create-build-auto-deploy
  type: http
  seq: 2
}

post {
  url: {{serviceURL}}/apps/{{testBuildDeployTafAppID}}/envs/{{testBuildDeployTafEnvName}}/taf-build-deploys
  body: json
  auth: inherit
}

body:json {
  {
    "branch": "main",
    "imageTag": "v1.0.0-build-deploy-taf",
    "replicas": 2
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  if (res.body && res.body.data) {
    if (res.body.data.buildID) {
      bru.setVar("testBuildDeployTafBuildID", res.body.data.buildID);
      console.log("Created taf-build-deploy build ID:", res.body.data.buildID);
    }
  }
}

tests {
  test("should create taf-build-deploy successfully", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('object');
  });

  test("should return build-like response fields", () => {
    const buildData = res.body.data;
    expect(buildData.buildID).to.be.a('string');
    expect(buildData.pipelineID).to.be.a('string');
    expect(buildData.status).to.be.a('string');
    expect(buildData.params.BKMS_IMAGE_TAG).to.equal('v1.0.0-build-deploy-taf');
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
