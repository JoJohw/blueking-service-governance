meta {
  name: update-build-config
  type: http
  seq: 1
}

put {
  url: {{serviceURL}}/apps/{{testBuildDeployTafAppID}}/build-configs
  body: json
  auth: inherit
}

body:json {
  {
    "sourceType": "codeRepository",
    "codeRepo": {
      "type": "TGit",
      "defaultBranch": "main",
      "repoAlias": "test-build-deploy-taf-repo",
      "repoURL": "https://git.com/bkms-govern-build-deploy-taf.git",
      "sourceDir": ".",
      "dockerfile": "Dockerfile",
      "dockerBuildArgs": {
        "ARG1": "value1",
        "ARG2": "value2"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should update build config for taf-build-deploy app", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('object');
    expect(res.body.data.sourceType).to.equal('codeRepository');
    expect(res.body.data.codeRepo.repoAlias).to.equal('test-build-deploy-taf-repo');
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
