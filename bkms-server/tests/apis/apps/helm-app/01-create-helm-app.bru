meta {
  name: 01-create-helm-app
  type: http
  seq: 1
}

post {
  url: {{serviceURL}}/workspaces/{{workspaceID}}/apps
  body: json
  auth: inherit
}

body:json {
  {
    "name": "app-crud-test-{{randomSuffix}}",
    "id": "app-crud-test-{{randomSuffix}}-id",
    "type": "helm",
    "displayName": "App CRUD Test",
    "buildConfig": {
      "sourceType": "imageRegistry",
      "pipelineType": "123",
      "imageBuildConfig": {
        "name": "app-crud-test"
      }
    },
    "helmSpec": {
      "helmSource": {
        "repoType": "HelmRepo",
        "helmRepoConfig": {
          "repoURL": "http://www.example.com/helm",
          "chartName": "test-chart"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  // Save app name and ID for later tests in the sequence
  if (res.body && res.body.data) {
    if (res.body.data.name) {
      bru.setVar('testAppName', res.body.data.name);
      console.log("Saved testAppName:", res.body.data.name);
    }
    if (res.body.data.id) {
      bru.setVar('testAppID', res.body.data.id);
      console.log("Saved testAppID:", res.body.data.id);
    }
  }
}

tests {
  test("should create app successfully", () => {
    console.log("Create app response:", JSON.stringify(res.body, null, 2));
    expect(res.body.data.type).to.equal('helm');
    expect(res.body.data.name).to.contain(bru.getVar('randomSuffix'));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
