meta {
  name: 03-update-display-name
  type: http
  seq: 3
}

put {
  url: {{serviceURL}}/apps/{{testAppID}}/display-name
  body: json
  auth: inherit
}

body:json {
  {
    "displayName": "Updated App Name"
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should update app display name successfully", () => {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
