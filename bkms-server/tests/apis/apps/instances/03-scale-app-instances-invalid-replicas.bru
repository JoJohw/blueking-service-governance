meta {
  name: 03-scale-app-instances-invalid-replicas
  type: http
  seq: 3
}

put {
  url: {{serviceURL}}/apps/invalid-app/envs/test/instances/operations/scale
  body: json
  auth: inherit
}

body:json {
  {
    "trafficLaneName": "",
    "targetReplicas": -1
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject negative target replicas", () => {
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
