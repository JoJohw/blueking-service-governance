meta {
  name: 04-batch-delete-app-instances-invalid-body
  type: http
  seq: 4
}

post {
  url: {{serviceURL}}/apps/invalid-app/envs/test/instances/operations/batch_delete
  body: json
  auth: inherit
}

body:json {
  {
    "trafficLaneName": "",
    "instanceIDs": []
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should require at least one instance id", () => {
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
