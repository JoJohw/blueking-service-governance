meta {
  name: 11-execute-taf-admin-cmd-invalid-body
  type: http
  seq: 11
}

post {
  url: {{serviceURL}}/apps/invalid-app/envs/test/instances/taf-admin-cmds
  body: json
  auth: inherit
}

body:json {
  {
    "instanceIDs": ["pod-1"],
    "command": ""
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should require TAF admin command", () => {
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
