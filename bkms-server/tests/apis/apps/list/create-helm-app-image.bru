meta {
  name: create-helm-app-image
  type: http
  seq: 1
}

post {
  url: {{serviceURL}}/workspaces/{{workspaceID}}/apps
  body: json
  auth: inherit
}

body:json {
  {
    "name": "api-test-app-helm-{{randomSuffix}}",
    "id": "api-test-app-helm-{{randomSuffix}}-id",
    "type": "helm",
    "buildConfig": {
      "sourceType": "imageRegistry",
      "pipelineType": "123",
      "imageBuildConfig": {
        "name": "api-test-app"
      }
    },
    "helmSpec": {
      "helmSource": {
        "repoType": "HelmRepo",
        "helmRepoConfig": {
          "repoURL": "http://www.example.com/foo",
          "chartName": "foobar"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  bru.setVar('newHelmAppID', res.body.data.id);
  bru.setVar('newHelmAppName', res.body.data.name);
}

tests {
  test("should return the right type and name", () => {
    expect(res.body.data.type).to.equal('helm');
    expect(res.body.data.name).to.contain('api-test-app-helm');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
