meta {
  name: delete-helm-app
  type: http
  seq: 6
}

delete {
  url: {{serviceURL}}/apps/{{newHelmAppID}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should delete helm app successfully", () => {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
