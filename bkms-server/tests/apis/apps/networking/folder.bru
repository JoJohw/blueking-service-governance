meta {
  name: networking
  seq: 4
}

auth {
  mode: inherit
}

script:pre-request {
  const common = require("./common")

  if (!bru.getVar("networkingHelmAppID")) {
    const suffix = bru.getVar("randomSuffix");
    const ws = await common.createWorkspace({id: `networking-ws-${suffix}`})
    const app = await common.createHelmApp({id: `networking-helm-app-${suffix}`, workspaceID: ws.id})

    bru.setVar("networkingWorkspaceID", ws.id);
    bru.setVar("networkingHelmAppID", app.id);
    bru.setVar("networkingHelmAppName", app.name);
  }

  bru.setVar("workspaceID", bru.getVar("networkingWorkspaceID"));
}
