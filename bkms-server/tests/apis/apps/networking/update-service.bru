meta {
  name: update-service
  type: http
  seq: 3
}

put {
  url: {{serviceURL}}/apps/{{networkingHelmAppID}}/services/{{newServiceName}}
  body: json
  auth: inherit
}

body:json {
  {
    "selector": {"app": "{{networkingHelmAppID}}"},
    "ports": [{"name": "api", "port": 80, "targetPort": "5000", "protocol": "TCP"}]
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
