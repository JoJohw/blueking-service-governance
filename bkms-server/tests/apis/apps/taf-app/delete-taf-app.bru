meta {
  name: delete-taf-app
  type: http
  seq: 4
}

delete {
  url: {{serviceURL}}/apps/{{testTafAppID}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should delete taf app successfully", () => {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
