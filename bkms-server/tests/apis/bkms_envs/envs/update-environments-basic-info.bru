meta {
  name: update-environments-basic-info
  type: http
  seq: 4
}

put {
  url: {{serviceURL}}/envs/{{envID}}/basic-info
  body: json
  auth: inherit
}

body:json {
  {
    "type": "{{newEnvType}}",
    "displayName": "{{newEnvDisplayName}}"
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  const suffix = bru.getVar("randomSuffix");

  bru.setVar("newEnvDisplayName", `env-new-${suffix}`);
  bru.setVar("newEnvType", "production")
}

settings {
  encodeUrl: true
  timeout: 0
}
