meta {
  name: app-component
  seq: 3
}

script:pre-request {
  const common = require("./common")

  if (!bru.getVar("componentsTrpcAppID") || !bru.getVar("componentsWorkspaceID")) {
    const suffix = bru.getVar("randomSuffix");
    const ws = await common.createWorkspace({id: `components-ws-${suffix}`})
    const app = await common.createTrpcApp({id: `components-trpc-app-${suffix}`, workspaceID: ws.id})

    bru.setVar("workspaceID", ws.id);
    bru.setVar("componentsWorkspaceID", ws.id);
    bru.setVar("componentsTrpcAppID", app.id);
  }

  const workspaceID = bru.getVar("componentsWorkspaceID");
  bru.setVar("workspaceID", workspaceID);

  await common.ensureGlobalVolumeSecretWorkspaceComponent({
    workspaceID,
    resultVar: "appComponentWorkspaceCompName"
  });
}
