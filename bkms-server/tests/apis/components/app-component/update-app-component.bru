meta {
  name: update-app-component
  type: http
  seq: 3
}

patch {
  url: {{serviceURL}}/apps/{{componentsTrpcAppID}}/components/{{testAppCompName}}
  body: json
  auth: inherit
}

body:json {
  {
    "properties": {
      "path": "/data/updated-app-secret",
      "secretName": "updated-app-secret"
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should update app component properties successfully", () => {
    console.log(res.body)
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
