meta {
  name: delete-app-component-not-exist
  type: http
  seq: 1
}

delete {
  url: {{serviceURL}}/apps/{{componentsTrpcAppID}}/components/not-exist-component
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should delete non-existent app component without error", () => {
    // 删除不存在的组件不返回错误
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
