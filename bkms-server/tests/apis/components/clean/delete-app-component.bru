meta {
  name: delete-app-component
  type: http
  seq: 2
}

delete {
  url: {{serviceURL}}/apps/{{componentsTrpcAppID}}/components/{{testAppCompName}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should delete app component successfully", () => {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
