meta {
  name: get-app-after-clean-comp
  type: http
  seq: 7
}

get {
  url: {{serviceURL}}/apps/{{componentsTrpcAppID}}
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should get app with empty components", () => {
    const { data } = res.body;

    expect(data).to.have.property('appModelSpec');
    expect(data.appModelSpec).to.have.property('components');
    expect(data.appModelSpec.components).to.be.an('array');
    expect(data.appModelSpec.components.length).to.be.equal(0);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
