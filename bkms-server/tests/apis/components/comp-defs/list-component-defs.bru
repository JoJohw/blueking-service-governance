meta {
  name: list-component-defs
  type: http
  seq: 3
}

get {
  url: {{serviceURL}}/component-defs
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should list component definitions successfully", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('array');
  });

  test("should return component def with correct structure", () => {
    if (res.body.data && res.body.data.length > 0) {
      const compDef = res.body.data[0];
      expect(compDef).to.have.property('name');
      expect(compDef).to.have.property('properties');
      expect(compDef).to.have.property('patchers').that.is.an('array');
      expect(compDef).to.have.property('specs').that.is.an('array');
      expect(compDef).to.have.property('scopeType');
    }
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
