meta {
  name: list-builtin-vars
  type: http
  seq: 1
}

get {
  url: {{serviceURL}}/component-defs/builtin-vars
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should list builtin variables successfully", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('array').with.lengthOf(6);
  });

  test("should return system variables with descriptions", () => {
    const varsByKey = Object.fromEntries(res.body.data.map((item) => [item.key, item]));

    expect(varsByKey).to.have.property("bkmsAppName");
    expect(varsByKey.bkmsAppName.description).to.be.a("string").and.not.empty;
    expect(varsByKey).to.have.property("name");
    expect(varsByKey.name.description).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
