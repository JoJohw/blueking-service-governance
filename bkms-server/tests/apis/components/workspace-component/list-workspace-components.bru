meta {
  name: list-workspace-components
  type: http
  seq: 3
}

get {
  url: {{serviceURL}}/workspaces/{{workspaceID}}/components
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should list workspace components successfully", () => {
    console.log(res.body)
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('array');
  });

  test("should return component with correct structure", () => {
    if (res.body.data && res.body.data.length > 0) {
      const comp = res.body.data[0];
      expect(comp).to.have.property('name');
      expect(comp).to.have.property('workspaceID');
      expect(comp).to.have.property('type');
      expect(comp).to.have.property('version');
      expect(comp).to.have.property('scopeType');
      expect(comp).to.have.property('createdAt');
      expect(comp).to.have.property('updatedAt');
    }
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
