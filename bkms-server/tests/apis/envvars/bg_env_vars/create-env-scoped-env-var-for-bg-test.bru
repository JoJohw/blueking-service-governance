meta {
  name: create-env-scoped-env-var-for-bg-test
  type: http
  seq: 3
}

post {
  url: {{serviceURL}}/workspaces/{{bgEnvVarsWorkspaceID}}/scoped-env-vars
  body: json
  auth: inherit
}

body:json {
  {
    "scopeType": "env",
    "scopeValue": "{{bgEnvVarsEnvName}}",
    "key": "{{bgTestEnvKey}}",
    "value": "{{bgTestEnvValue}}",
    "description": "env scoped var for bg test",
    "isSensitive": false
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  const suffix = bru.getVar("randomSuffix");
  bru.setVar("bgTestEnvKey", `BG_ENV_KEY_${suffix}`);
  bru.setVar("bgTestEnvValue", `bg-env-value-${suffix}`);
}

tests {
  test("should create env scoped env var", () => {
    const ret = res.body.data;
    expect(ret.scopeType).to.equal("env");
    expect(ret.scopeValue).to.equal(bru.getVar("bgEnvVarsEnvName"));
    expect(ret.key).to.equal(bru.getVar("bgTestEnvKey"));
    expect(ret.value).to.equal(bru.getVar("bgTestEnvValue"));
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
