meta {
  name: create-env-scoped-env-var-for-order
  type: http
  seq: 5
}

post {
  url: {{serviceURL}}/workspaces/{{envvarsWorkspaceID}}/scoped-env-vars
  body: json
  auth: inherit
}

body:json {
  {
    "scopeType": "env",
    "scopeValue": "{{envvarsEnvName}}",
    "key": "{{envScopedOrderKey}}",
    "value": "{{envScopedOrderValue}}",
    "description": "{{envScopedOrderDescription}}",
    "isSensitive": false
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  const suffix = bru.getVar("randomSuffix");
  bru.setVar("envScopedOrderKey", `ENV_SCOPED_ORDER_KEY_${suffix}`);
  bru.setVar("envScopedOrderValue", `env-scoped-order-value-${suffix}`);
  bru.setVar("envScopedOrderDescription", `env-scoped-order-description-${suffix}`);
}

script:post-response {
  bru.setVar("envScopedOrderEnvVarID", res.body.data.id);
}

tests {
  test("should create another env scoped env var for ordering check", () => {
    const ret = res.body.data;

    expect(ret.workspaceID).to.equal(bru.getVar("envvarsWorkspaceID"));
    expect(ret.scopeType).to.equal("env");
    expect(ret.scopeValue).to.equal(bru.getVar("envvarsEnvName"));
    expect(ret.key).to.equal(bru.getVar("envScopedOrderKey"));
    expect(ret.value).to.equal(bru.getVar("envScopedOrderValue"));
    expect(ret.description).to.equal(bru.getVar("envScopedOrderDescription"));
    expect(ret.isSensitive).to.equal(false);
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
