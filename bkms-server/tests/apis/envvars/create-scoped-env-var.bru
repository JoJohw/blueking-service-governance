meta {
  name: create-scoped-env-var
  type: http
  seq: 1
}

post {
  url: {{serviceURL}}/workspaces/{{envvarsWorkspaceID}}/scoped-env-vars
  body: json
  auth: inherit
}

body:json {
  {
    "scopeType": "workspace",
    "scopeValue": "",
    "key": "{{workspaceScopedKey}}",
    "value": "{{workspaceScopedValue}}",
    "description": "{{workspaceScopedDescription}}",
    "isSensitive": false
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  const suffix = bru.getVar("randomSuffix");
  bru.setVar("workspaceScopedKey", `SCOPED_KEY_${suffix}`);
  bru.setVar("workspaceScopedValue", `scoped-value-${suffix}`);
  bru.setVar("workspaceScopedDescription", `scoped-description-${suffix}`);
}

script:post-response {
  bru.setVar("workspaceScopedEnvVarID", res.body.data.id);
}

tests {
  test("should return the created scoped env var", () => {
    const ret = res.body.data;

    expect(ret.workspaceID).to.equal(bru.getVar("envvarsWorkspaceID"));
    expect(ret.scopeType).to.equal("workspace");
    expect(ret.scopeValue).to.equal("");
    expect(ret.key).to.equal(bru.getVar("workspaceScopedKey"));
    expect(ret.value).to.equal(bru.getVar("workspaceScopedValue"));
    expect(ret.description).to.equal(bru.getVar("workspaceScopedDescription"));
    expect(ret.isSensitive).to.equal(false);
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
