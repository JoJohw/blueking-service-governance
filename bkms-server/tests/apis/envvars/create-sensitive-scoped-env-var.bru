meta {
  name: create-sensitive-scoped-env-var
  type: http
  seq: 12
}

post {
  url: {{serviceURL}}/workspaces/{{envvarsWorkspaceID}}/scoped-env-vars
  body: json
  auth: inherit
}

body:json {
  {
    "scopeType": "workspace",
    "scopeValue": "",
    "key": "{{sensitiveScopedKey}}",
    "value": "{{sensitiveScopedValue}}",
    "description": "{{sensitiveScopedDescription}}",
    "isSensitive": true
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  const suffix = bru.getVar("randomSuffix");
  bru.setVar("sensitiveScopedKey", `SCOPED_SENSITIVE_${suffix}`);
  bru.setVar("sensitiveScopedValue", `sensitive-value-${suffix}`);
  bru.setVar("sensitiveScopedDescription", `sensitive-description-${suffix}`);
}

script:post-response {
  bru.setVar("sensitiveScopedEnvVarID", res.body.data.id);
}

tests {
  test("should create a sensitive scoped env var and mask its value", () => {
    const ret = res.body.data;

    expect(ret.workspaceID).to.equal(bru.getVar("envvarsWorkspaceID"));
    expect(ret.scopeType).to.equal("workspace");
    expect(ret.scopeValue).to.equal("");
    expect(ret.key).to.equal(bru.getVar("sensitiveScopedKey"));
    // Sensitive values are masked on read.
    expect(ret.value).to.equal("******");
    expect(ret.description).to.equal(bru.getVar("sensitiveScopedDescription"));
    expect(ret.isSensitive).to.equal(true);
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
