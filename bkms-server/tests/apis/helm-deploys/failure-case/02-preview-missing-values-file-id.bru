meta {
  name: 02-preview-missing-values-file-id
  type: http
  seq: 2
}

get {
  url: {{serviceURL}}/apps/nonexistent-helm-deploy-app/envs/test/helm-deploys/preview?imageTag=v1&chartVersion=1.0.0
  body: none
  auth: inherit
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject missing values file id before previewing Helm release", () => {
    expect(res.body.error).to.be.an("object");
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
  });
}

settings {
  encodeUrl: true
  timeout: 5000
}
