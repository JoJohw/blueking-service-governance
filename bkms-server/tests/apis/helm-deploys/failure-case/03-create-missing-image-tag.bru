meta {
  name: 03-create-missing-image-tag
  type: http
  seq: 3
}

post {
  url: {{serviceURL}}/apps/nonexistent-helm-deploy-app/envs/test/helm-deploys
  body: json
  auth: inherit
}

body:json {
  {
    "chartVersion": "1.0.0",
    "valuesFileID": "values-id"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject missing image tag before deploying Helm release", () => {
    expect(res.body.error).to.be.an("object");
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
  });
}

settings {
  encodeUrl: true
  timeout: 5000
}
