meta {
  name: 04-preview-rollback-nonexistent-app
  type: http
  seq: 4
}

get {
  url: {{serviceURL}}/apps/nonexistent-helm-deploy-app/envs/test/helm-deploys/deploy-id/preview
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
  res.body: isJson
}

tests {
  test("should return not found without previewing rollback", () => {
    expect(res.body.error).to.be.an("object");
    expect(res.body.error.code).to.equal("NOT_FOUND");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
  });
}

settings {
  encodeUrl: true
  timeout: 5000
}
