meta {
  name: 01-preview
  type: http
  seq: 1
}

get {
  url: {{serviceURL}}/apps/{{helmLifecycleAppID}}/envs/{{helmLifecycleEnvName}}/helm-deploys/preview?imageTag={{helmLifecycleImageTag1}}&chartVersion={{helmLifecycleChartVersion}}&valuesFileID={{helmLifecycleValuesFileID}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should preview the target Helm manifest with image tag v1", () => {
    expect(res.body.current).to.be.a("string");
    expect(res.body.target).to.be.a("string");
    expect(res.body.target).to.contain("kind: Deployment");
    expect(res.body.target).to.contain("kind: Service");
    expect(res.body.target).to.contain(`${bru.getVar("helmLifecycleImageRepository")}:${bru.getVar("helmLifecycleImageTag1")}`);
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
