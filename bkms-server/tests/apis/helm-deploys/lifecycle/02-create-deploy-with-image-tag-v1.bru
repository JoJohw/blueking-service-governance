meta {
  name: 02-create-deploy-with-image-tag-v1
  type: http
  seq: 2
}

post {
  url: {{serviceURL}}/apps/{{helmLifecycleAppID}}/envs/{{helmLifecycleEnvName}}/helm-deploys
  body: json
  auth: inherit
}

body:json {
  {
    "imageTag": "{{helmLifecycleImageTag1}}",
    "chartVersion": "{{helmLifecycleChartVersion}}",
    "valuesFileID": "{{helmLifecycleValuesFileID}}"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
}

script:post-response {
  // Wait until the v1 release converges to `deployed` on the external K8s
  // cluster. helm.waitForDeploy polls bkms-server's list API.
  const helm = require("./helpers/helm");

  const record = await helm.waitForDeploy({
    appID: bru.getVar("helmLifecycleAppID"),
    envName: bru.getVar("helmLifecycleEnvName"),
    expectedStatus: "deployed",
    imageTag: bru.getVar("helmLifecycleImageTag1")
  });
  bru.setVar("helmLifecycleFirstDeployID", record.id);
}

tests {
  test("should create the v1 helm-deploy and converge to deployed", () => {
    expect(res.body).to.deep.equal({});
    expect(bru.getVar("helmLifecycleFirstDeployID")).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 70000
}
