meta {
  name: 04-create-deploy-with-image-tag-v2
  type: http
  seq: 4
}

post {
  url: {{serviceURL}}/apps/{{helmLifecycleAppID}}/envs/{{helmLifecycleEnvName}}/helm-deploys
  body: json
  auth: inherit
}

body:json {
  {
    "imageTag": "{{helmLifecycleImageTag2}}",
    "chartVersion": "{{helmLifecycleChartVersion}}",
    "valuesFileID": "{{helmLifecycleValuesFileID}}"
  }
}

script:pre-request {
  if (!bru.getProcessEnv("RUN_HELM_DEPLOY_API_TESTS")) {
    console.log("helm lifecycle skipped: RUN_HELM_DEPLOY_API_TESTS not set");
    bru.runner.skipRequest();
    return;
  }

  // Update the values file so the v2 release picks up the new image tag.
  const helmDeployCommon = require("./common");
  const imageRepository = bru.getVar("helmLifecycleImageRepository");
  const imageTag = bru.getVar("helmLifecycleImageTag2");
  const helmValuesContent = [
    "replicaCount: 1",
    "image:",
    `  repository: ${imageRepository}`,
    `  tag: "${imageTag}"`,
    "  pullPolicy: IfNotPresent",
    "service:",
    "  type: ClusterIP",
    "  port: 80",
    "resources: {}",
    ""
  ].join("\n");

  await helmDeployCommon.updateAppConfigFileContent({
    appID: bru.getVar("helmLifecycleAppID"),
    fileID: bru.getVar("helmLifecycleValuesFileID"),
    content: helmValuesContent,
    versionDescription: "Update Helm deploy values for v2"
  });
}

assert {
  res.status: eq 201
  res.body: isJson
}

script:post-response {
  const helm = require("./helpers/helm");

  const record = await helm.waitForDeploy({
    appID: bru.getVar("helmLifecycleAppID"),
    envName: bru.getVar("helmLifecycleEnvName"),
    expectedStatus: "deployed",
    imageTag: bru.getVar("helmLifecycleImageTag2"),
    excludeID: bru.getVar("helmLifecycleFirstDeployID")
  });
  bru.setVar("helmLifecycleSecondDeployID", record.id);
}

tests {
  test("should create the v2 helm-deploy distinct from v1", () => {
    expect(res.body).to.deep.equal({});
    expect(bru.getVar("helmLifecycleSecondDeployID")).to.be.a("string").and.not.empty;
    expect(bru.getVar("helmLifecycleSecondDeployID")).to.not.equal(bru.getVar("helmLifecycleFirstDeployID"));
  });
}

settings {
  encodeUrl: true
  timeout: 70000
}
