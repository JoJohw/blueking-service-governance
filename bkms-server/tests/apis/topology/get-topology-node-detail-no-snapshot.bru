meta {
  name: get-topology-node-detail-no-snapshot
  type: http
  seq: 3
}

get {
  url: {{serviceURL}}/apps/{{topologyAppID}}/envs/{{topologyEnvName}}/resource-topology/nodes/{{topologyNodeID}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 500
  res.body: isJson
}

tests {
  test("should return internal error when no resource snapshot exists for node detail", () => {
    expect(res.body.error.code).to.equal("INTERNAL_SERVER_ERROR");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
    expect(res.body.error.message).to.contain("get node detail: resolve node");
    expect(res.body.error.message).to.contain("no resource snapshot found");
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
