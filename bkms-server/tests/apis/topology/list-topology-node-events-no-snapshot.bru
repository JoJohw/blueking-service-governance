meta {
  name: list-topology-node-events-no-snapshot
  type: http
  seq: 5
}

get {
  url: {{serviceURL}}/apps/{{topologyAppID}}/envs/{{topologyEnvName}}/resource-topology/nodes/{{topologyNodeID}}/events?page=1&pageSize=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 10
}

assert {
  res.status: eq 500
  res.body: isJson
}

tests {
  test("should return internal error when no resource snapshot exists for node events", () => {
    expect(res.body.error.code).to.equal("INTERNAL_SERVER_ERROR");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
    expect(res.body.error.message).to.contain("list node events: no resource snapshot found");
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
