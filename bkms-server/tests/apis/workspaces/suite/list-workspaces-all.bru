meta {
  name: list-workspaces-all
  type: http
  seq: 5
}

get {
  url: {{serviceURL}}/workspaces
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data[0].bkSystems: isJson
}

tests {
  test("should return workspaces list", () => {
    expect(res.body.data).to.be.an('array');
    expect(res.body.data.length).to.be.greaterThanOrEqual(3);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
