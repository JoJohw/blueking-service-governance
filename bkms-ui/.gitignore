.DS_Store
.vite-ssg-dist
.vite-ssg-temp
*.local
dist
dist-ssr
node_modules
.idea/
*.log
cypress/downloads

# E2E：playwright-bdd 生成 spec、Playwright 运行产物（trace 等）
.features-gen/
test-results/
.auth/
mocks.json

pre-*-bkcodeai
.env.development
.env.test
tsconfig.tsbuildinfo

# 主题工具链产物（theme-codemod / theme-lint 脚本可重建）
scripts/theme-codemod/reports/*
scripts/theme-lint/reports/*

# lint 缓存
.stylelintcache
.eslintcache

# 仓库根 .gitignore 的 *vendor* 会命中目录名与文件名，以下三项需入库（只放行这些路径）
!src/styles/theme/patches/vendor/
!src/styles/theme/patches/vendor/**
!scripts/theme-codemod/scripts/theme-check-vendor.mjs
