# syntax=docker/dockerfile:1
# 生产静态站点：一次构建、多环境部署
# 运行时通过 ENV_FILE 或 -e 注入 BK_* 环境变量，无需为每个环境构建单独镜像

FROM node:23-alpine AS build

ARG BKMS_APP_VERSION
ARG BK_CI_GIT_REPO_HEAD_COMMIT_ID
ARG BK_CI_BUILD_NUM

ENV BKMS_APP_VERSION=${BKMS_APP_VERSION}
ENV BK_CI_GIT_REPO_HEAD_COMMIT_ID=${BK_CI_GIT_REPO_HEAD_COMMIT_ID}
ENV BK_CI_BUILD_NUM=${BK_CI_BUILD_NUM}
# Vite 打包大项目易触顶默认 ~2GiB 堆；Colima 建议 memory ≥ 8GiB
ENV NODE_OPTIONS=--max-old-space-size=8192

WORKDIR /app
RUN corepack enable

COPY .npmrc package.json pnpm-lock.yaml ./
# 不使用 RUN --mount=type=cache：部分流水线 Docker 未启用 BuildKit，会报 Unknown flag: mount
RUN pnpm install --frozen-lockfile

COPY . .
# 生产镜像按根路径部署，Vite base 须为 ''。loadEnv 优先采用 process.env，此处强制覆盖
ENV BK_STATIC_URL=
RUN pnpm build --mode production

# 运行阶段：仅静态文件 + Nginx，无 Node 运行时
FROM nginx:1.30-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx-default.conf /etc/nginx/conf.d/default.conf
COPY docker/security_headers.conf /etc/nginx/security_headers.conf
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh \
    && mkdir -p /var/cache/nginx/client_temp \
                /var/cache/nginx/proxy_temp \
                /var/cache/nginx/fastcgi_temp \
                /var/cache/nginx/uwsgi_temp \
                /var/cache/nginx/scgi_temp \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && chown -R nginx:nginx /run \
    && chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /etc/nginx

# 切换到非 root 用户运行，降低安全风险（nginx 镜像自带 nginx 用户）
USER nginx

# 官方 nginx:alpine 含 BusyBox wget（-O /dev/null 兼容 BusyBox / GNU）
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO/dev/null http://127.0.0.1:5000/ || exit 1

EXPOSE 5000
ENTRYPOINT ["/docker-entrypoint.sh"]
